# Use a long URL-safe password (letters and digits); it is interpolated into DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
# Local: ./ .data; Holocron: /mnt/nvme_cache/appdata/gnocchi
GNOCCHI_DATA_DIR=./.data
GNOCCHI_BIND_IP=127.0.0.1
GNOCCHI_WEB_PORT=9085
# Optional: recipe reading and editing work without this key.
ANTHROPIC_API_KEY=
